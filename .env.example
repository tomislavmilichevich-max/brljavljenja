# Kopiraj u .env.local i popuni vrijednostima iz Firebase Console
# (Project settings > General > Your apps > Web app > SDK setup and configuration).
# Ove vrijednosti NISU tajne (identificiraju projekt), ali .env.* ipak ne commitamo.
# Sigurnost osigurava Firestore Security Rules, ne skrivanje ovih vrijednosti.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ID kućanstva kojem aplikacija pristupa (pilot: jedno kućanstvo, seed ručno).
VITE_HOUSEHOLD_ID=
