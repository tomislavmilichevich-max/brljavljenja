rules_version = '2';

// P0: ZAKLJUČANO — deny by default. Pravila članstva kućanstva implementira faza P1
// (uz testove u Firebase Emulator Suite). Nikada `allow read, write: if true`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
